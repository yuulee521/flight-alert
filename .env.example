# Home location
HOME_LAT=52.3162
HOME_LON=5.0392


# Alert criteria
RADIUS_KM=5
MAX_ALTITUDE_M=2000
POLL_SECONDS=10
ALERT_COOLDOWN_SECONDS=1800
STALE_AIRCRAFT_SECONDS=30

# Public ntfy.sh topic. For privacy, use a private/self-hosted server or a long random topic.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=over-weesp-flights-alerts
NTFY_PRIORITY=high
NTFY_TAGS=airplane

# Optional: comma-separated ICAO aircraft type allowlist.
# Defaults include common passenger/cargo widebodies.
WIDEBODY_TYPES=A300,A310,A330,A332,A333,A338,A339,A340,A342,A343,A345,A346,A350,A359,A35K,A380,A388,B741,B742,B743,B744,B748,B74S,B74R,B762,B763,B764,B772,B773,B77L,B77W,B778,B779,B788,B789,B78X,MD11,DC10,IL96

# Optional source override. Airplanes.live currently allows unauthenticated non-commercial use.
AIRCRAFT_API_URL=https://api.airplanes.live/v2/point/{lat}/{lon}/{radius_nm}

# Optional route enrichment for FromCity.
# ADS-B position messages do not include departure city, so this is a best-effort callsign lookup.
ROUTE_LOOKUP_ENABLED=true
ROUTE_API_URL=https://api.adsbdb.com/v0/callsign/{callsign}
ROUTE_CACHE_SECONDS=1800
